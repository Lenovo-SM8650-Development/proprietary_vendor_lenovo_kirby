android_app_import {
    name: "KirbyDaxService",
    owner: "lenovo",
    apk: "motorola/system_ext/priv-app/daxService/daxService.apk",
    filename: "daxService.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
}

android_app_import {
    name: "MotoSignatureApp",
    owner: "motorola",
    apk: "motorola/system_ext/app/MotoSignatureApp/MotoSignatureApp.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    system_ext_specific: true,
}

android_app_import {
    name: "MotoDolbyDax3",
    owner: "motorola",
    apk: "motorola/system_ext/priv-app/MotoDolbyDax3/MotoDolbyDax3.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
}

android_app_import {
    name: "MotorolaSettingsProvider",
    owner: "motorola",
    apk: "motorola/system_ext/priv-app/MotorolaSettingsProvider/MotorolaSettingsProvider.apk",
    certificate: "platform",
    dex_preopt: {
        enabled: false,
    },
    privileged: true,
    system_ext_specific: true,
}

dex_import {
    name: "com.motorola.frameworks.core.addon",
    owner: "motorola",
    jars: ["motorola/system_ext/framework/com.motorola.frameworks.core.addon.jar"],
    system_ext_specific: true,
}

dex_import {
    name: "com.motorola.motosignature",
    owner: "motorola",
    jars: ["motorola/system_ext/framework/com.motorola.motosignature.jar"],
    system_ext_specific: true,
}

dex_import {
    name: "moto-checkin",
    owner: "motorola",
    jars: ["motorola/system_ext/framework/moto-checkin.jar"],
    system_ext_specific: true,
}

dex_import {
    name: "moto-settings",
    owner: "motorola",
    jars: ["motorola/system_ext/framework/moto-settings.jar"],
    system_ext_specific: true,
}

dex_import {
    name: "moto",
    owner: "motorola",
    jars: ["motorola/system_ext/framework/moto.jar"],
    system_ext_specific: true,
}

vintf_fragment {
    name: "kirby_dolby_dms_manifest",
    src: "vendor/etc/vintf/manifest/vendor.dolby.hardware.dms.xml",
    vendor: true,
}

vintf_fragment {
    name: "kirby_dolby_codec2_manifest",
    src: "vendor/etc/vintf/manifest/vendor.dolby.media.c2@1.0-service.xml",
    vendor: true,
}
