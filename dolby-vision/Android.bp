vintf_fragment {
    name: "kirby_dolby_vision_codec2_manifest",
    src: "stock/etc/vintf/manifest/dolby-vision-codec2.xml",
    vendor: true,
}

vintf_fragment {
    name: "kirby_dolby_vision_dvs_manifest",
    src: "stock/etc/vintf/manifest/dvs-aidl-service.xml",
    vendor: true,
}

cc_library_shared {
    name: "libkirby_dolby_vision_compat",
    vendor: true,
    compile_multilib: "64",
    srcs: ["compat.cpp"],
    shared_libs: [
        "android.hardware.graphics.bufferqueue@1.0",
        "libbase",
        "libbinder",
        "libstagefright_bufferqueue_helper",
        "libui",
        "libutils",
    ],
}
